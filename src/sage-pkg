#!/bin/bash
# sage-pkg — SageOS mission-pack installer
# Wraps apt-get / GitHub releases / pip with curated cybersecurity tool categories.
# category type (col 5): apt (all tools via apt) | builtin (pre-baked, can't be removed)
#     | fetch (all tools downloaded from GitHub releases) | mixed (per-tool override)
# Per-tool override: append @apt, @fetch, or @pip to a tool name in the packages
# column to force that tool's install method regardless of the category's default
# type — e.g. "recon-ng amass@fetch sherlock@pip" in a category typed "mixed".

CONF="/usr/local/share/sage-pkg/categories.conf"
FETCH_CONF="/usr/local/share/sage-pkg/fetch-tools.conf"
PIP_CONF="/usr/local/share/sage-pkg/pip-tools.conf"
DESC_CONF="/usr/local/share/sage-pkg/tool-descriptions.conf"
STATE_DIR="/var/lib/sage-pkg"
SAGE_PKG_VERSION="2.2"
CATALOG_BASE="https://raw.githubusercontent.com/zackmsa777-a11y/sageos/main/src/sage-pkg-catalog"
CATALOG_DOCS_BASE="https://raw.githubusercontent.com/zackmsa777-a11y/sageos/main/docs"
CATALOG_VERSION_FILE="/usr/local/share/sage-pkg/VERSION"
SAGE_PKG_SELF_URL="https://raw.githubusercontent.com/zackmsa777-a11y/sageos/main/src/sage-pkg"
mkdir -p "$STATE_DIR"

CYAN='\033[36m'; MAG='\033[35m'; YEL='\033[33m'; GRN='\033[32m'; RED='\033[31m'; BOLD='\033[1m'; RST='\033[0m'

usage() {
    echo -e "${BOLD}sage-pkg${RST} v$SAGE_PKG_VERSION — SageOS mission-pack installer"
    echo ""
    echo "Usage:"
    echo "  sage-pkg list                    List all available categories"
    echo "  sage-pkg show <category>         Show tools in a category"
    echo "  sage-pkg tools [category]        List tools with what they do"
    echo "  sage-pkg install <category|all>  Install a category (or every category)"
    echo "  sage-pkg remove <category|all>   Remove a category (or every category)"
    echo "  sage-pkg status                  Show which categories are installed"
    echo "  sage-pkg check [category]        Verify tools are actually present/working"
    echo "  sage-pkg search <term>           Search all categories for a tool"
    echo "  sage-pkg update [category|all]   Upgrade installed tools to their latest version (default: all installed)"
    echo "  sage-pkg update-catalog          Pull the latest categories/tools list from GitHub (no upgrades)"
    exit 1
}

get_field() { echo "$1" | cut -d'|' -f"$2"; }

find_category() {
    grep -v "^#" "$CONF" | grep -v "^$" | awk -F'|' -v c="$1" '$1==c'
}

all_categories() {
    grep -v "^#" "$CONF" | grep -v "^$" | cut -d'|' -f1
}

tool_desc() {
    local t="$1"
    local line; line=$(grep -v "^#" "$DESC_CONF" | awk -F'|' -v t="$t" '$1==t')
    if [[ -n "$line" ]]; then echo "$line" | cut -d'|' -f2; else echo "(no description yet)"; fi
}

# Strip an optional @apt / @fetch / @pip override suffix, return bare tool name
pkg_name() { echo "${1%%@*}"; }

# Resolve a token's effective install type: its own @suffix if present,
# else the category's default type (with "mixed" itself falling back to apt).
pkg_type() {
    local token="$1" cat_type="$2"
    if [[ "$token" == *"@"* ]]; then
        echo "${token##*@}"
    elif [[ "$cat_type" == "mixed" ]]; then
        echo "apt"
    else
        echo "$cat_type"
    fi
}

# Resolve the binary name actually placed on PATH for a token. For pip-type
# tools this can differ from the tool name (e.g. pwntools -> `pwn`,
# volatility3 -> `vol`) — look it up from pip-tools.conf. Everything else
# (apt, fetch, builtin) uses the bare tool name as-is.
effective_bin() {
    local token="$1" cat_type="$2"
    local n; n=$(pkg_name "$token")
    local t; t=$(pkg_type "$token" "$cat_type")
    if [[ "$t" == "pip" ]]; then
        local row; row=$(grep -v "^#" "$PIP_CONF" | awk -F'|' -v tt="$n" '$1==tt')
        local bin; bin=$(echo "$row" | cut -d'|' -f3)
        [[ -n "$bin" ]] && { echo "$bin"; return; }
    fi
    echo "$n"
}

cmd_list() {
    echo -e "${BOLD}${CYAN}SageOS Mission Packs${RST}"
    echo ""
    while IFS='|' read -r cat name desc pkgs type; do
        [[ "$cat" =~ ^#.*$ || -z "$cat" ]] && continue
        count=$(echo "$pkgs" | wc -w)
        installed=""
        [[ -f "$STATE_DIR/$cat.installed" ]] && installed=" ${GRN}[installed]${RST}"
        tag=""
        [[ "$type" == "builtin" ]] && tag=" ${YEL}[pre-installed]${RST}"
        [[ "$type" == "fetch" ]] && tag=" ${CYAN}[downloads on install]${RST}"
        [[ "$type" == "mixed" ]] && tag=" ${CYAN}[apt + downloads on install]${RST}"
        echo -e "  ${MAG}${cat}${RST} — ${name} (${count} tools)${installed}${tag}"
        echo "      $desc"
    done < "$CONF"
    echo ""
}

cmd_show() {
    local cat="$1"
    [[ -z "$cat" ]] && { echo "Usage: sage-pkg show <category>"; return 1; }
    local row; row=$(find_category "$cat")
    [[ -z "$row" ]] && { echo "Unknown category: $cat"; echo "Run 'sage-pkg list' to see options."; return 1; }
    local name desc pkgs type
    name=$(get_field "$row" 2); desc=$(get_field "$row" 3); pkgs=$(get_field "$row" 4); type=$(get_field "$row" 5)
    echo -e "${BOLD}${MAG}$cat${RST} — $name"
    echo "$desc"
    echo ""
    for p in $pkgs; do
        local n; n=$(pkg_name "$p")
        local t; t=$(pkg_type "$p" "$type")
        echo -e "  ${BOLD}$n${RST} ${CYAN}[$t]${RST} — $(tool_desc "$n")"
    done
    [[ "$type" == "fetch" || "$type" == "mixed" ]] && echo -e "\n${CYAN}(fetch/pip tools are downloaded from upstream on install — needs internet)${RST}"
}

cmd_tools() {
    local target="$1"
    while IFS='|' read -r cat name desc pkgs type; do
        [[ "$cat" =~ ^#.*$ || -z "$cat" ]] && continue
        [[ -n "$target" && "$cat" != "$target" ]] && continue
        echo -e "${BOLD}${MAG}$cat${RST} ($name)"
        for p in $pkgs; do
            local n; n=$(pkg_name "$p")
            local mark="  "
            local eb; eb=$(effective_bin "$p" "$type")
            if [[ "$(pkg_type "$p" "$type")" == "apt" ]]; then
                dpkg -s "$n" >/dev/null 2>&1 && mark="${GRN}✓${RST} "
            else
                command -v "$eb" >/dev/null 2>&1 && mark="${GRN}✓${RST} "
            fi
            echo -e "  $mark ${BOLD}$n${RST} — $(tool_desc "$n")"
        done
    done < "$CONF"
}

fetch_one() {
    local tool="$1"
    local row; row=$(grep -v "^#" "$FETCH_CONF" | awk -F'|' -v t="$tool" '$1==t')
    if [[ -z "$row" ]]; then echo -e "  ${RED}no fetch recipe for $tool${RST}"; return 1; fi
    local repo pattern; repo=$(echo "$row" | cut -d'|' -f2); pattern=$(echo "$row" | cut -d'|' -f3)
    echo "  Fetching $tool from $repo..."
    local api="https://api.github.com/repos/$repo/releases/latest"
    local url; url=$(curl -sL "$api" | grep -oP '"browser_download_url":\s*"\K[^"]+' | grep -P "$pattern" | head -1)
    if [[ -z "$url" ]]; then echo -e "  ${RED}could not find a release asset for $tool${RST}"; return 1; fi
    local tmp; tmp=$(mktemp -d)
    local fname="$tmp/asset"
    if ! curl -sL "$url" -o "$fname"; then echo -e "  ${RED}download failed for $tool${RST}"; find "$tmp" -delete; return 1; fi

    # .deb release asset — install via dpkg, resolving deps with apt-get -f
    if [[ "$url" == *.deb ]]; then
        if dpkg -i "$fname" >/tmp/sage-pkg-dpkg.log 2>&1 || apt-get install -f -y >>/tmp/sage-pkg-dpkg.log 2>&1; then
            echo -e "  ${GRN}installed${RST} $tool (.deb)"
            find "$tmp" -delete
            return 0
        else
            echo -e "  ${RED}deb install failed for $tool — see /tmp/sage-pkg-dpkg.log${RST}"
            find "$tmp" -delete
            return 1
        fi
    fi

    local ex="$tmp/extract"; mkdir -p "$ex"
    case "$url" in
        *.zip) unzip -o -q "$fname" -d "$ex" ;;
        *.tar.xz) tar xJf "$fname" -C "$ex" 2>/dev/null ;;
        *) tar xzf "$fname" -C "$ex" 2>/dev/null ;;
    esac
    # handle nested archive (e.g. a .tar.gz inside a .zip)
    local nested; nested=$(find "$ex" -name "*.tar.gz" -type f | head -1)
    [[ -n "$nested" ]] && tar xzf "$nested" -C "$ex" 2>/dev/null
    local bin; bin=$(find "$ex" -type f -iname "$tool" | head -1)
    if [[ -z "$bin" ]]; then echo -e "  ${RED}binary '$tool' not found inside archive${RST}"; find "$tmp" -delete; return 1; fi
    install -m 755 "$bin" "/usr/local/bin/$tool"
    find "$tmp" -delete
    echo -e "  ${GRN}installed${RST} $tool"
    return 0
}

pip_one() {
    local tool="$1"
    local row; row=$(grep -v "^#" "$PIP_CONF" | awk -F'|' -v t="$tool" '$1==t')
    if [[ -z "$row" ]]; then echo -e "  ${RED}no pip recipe for $tool${RST}"; return 1; fi
    local pip_pkg binary; pip_pkg=$(echo "$row" | cut -d'|' -f2); binary=$(echo "$row" | cut -d'|' -f3)
    echo "  Installing $tool ($pip_pkg) via pip..."
    if pip3 install --break-system-packages --quiet "$pip_pkg" >/tmp/sage-pkg-pip.log 2>&1; then
        if command -v "$binary" >/dev/null 2>&1; then
            echo -e "  ${GRN}installed${RST} $tool"
            return 0
        else
            echo -e "  ${YEL}installed $pip_pkg but '$binary' not on PATH — check ~/.local/bin${RST}"
            return 1
        fi
    else
        echo -e "  ${RED}pip install failed for $tool — see /tmp/sage-pkg-pip.log${RST}"
        return 1
    fi
}

install_token() {
    local token="$1" cat_type="$2"
    local n; n=$(pkg_name "$token")
    local t; t=$(pkg_type "$token" "$cat_type")
    case "$t" in
        fetch) fetch_one "$n" ;;
        pip) pip_one "$n" ;;
        apt) DEBIAN_FRONTEND=noninteractive apt-get install -y "$n" ;;
        *) echo -e "  ${RED}unknown type '$t' for $n${RST}"; return 1 ;;
    esac
}

remove_token() {
    local token="$1" cat_type="$2"
    local n; n=$(pkg_name "$token")
    local t; t=$(pkg_type "$token" "$cat_type")
    case "$t" in
        fetch) [[ -f "/usr/local/bin/$n" ]] && { find "/usr/local/bin/$n" -delete; echo "  removed $n"; } ;;
        pip)
            local row pip_pkg; row=$(grep -v "^#" "$PIP_CONF" | awk -F'|' -v tt="$n" '$1==tt')
            pip_pkg=$(echo "$row" | cut -d'|' -f2)
            [[ -n "$pip_pkg" ]] && pip3 uninstall --break-system-packages -y "$pip_pkg" >/dev/null 2>&1
            echo "  removed $n"
            ;;
        apt) DEBIAN_FRONTEND=noninteractive apt-get remove -y "$n" ;;
    esac
}

# Fresh SageOS ISOs ship with empty apt lists to stay lean — refresh them
# once, transparently, the first time any category actually needs apt.
ensure_apt_lists() {
    if ! ls /var/lib/apt/lists/*Packages* >/dev/null 2>&1; then
        echo -e "  ${CYAN}First install this boot — refreshing package lists (apt-get update)...${RST}"
        DEBIAN_FRONTEND=noninteractive apt-get update -qq
    fi
}

cmd_install_one() {
    local cat="$1"
    local row; row=$(find_category "$cat")
    [[ -z "$row" ]] && { echo "Unknown category: $cat"; echo "Run 'sage-pkg list' to see options."; return 1; }
    local name pkgs type
    name=$(get_field "$row" 2); pkgs=$(get_field "$row" 4); type=$(get_field "$row" 5)

    if [[ "$type" == "builtin" ]]; then
        echo -e "${BOLD}Mission pack:${RST} $name"
        echo -e "${YEL}These tools are pre-built and already shipped in the ISO — nothing to download.${RST}"
        local missing=0
        for p in $pkgs; do
            command -v "$p" >/dev/null 2>&1 || { echo "  not found: $p (unexpected — please report this)"; missing=1; }
        done
        [[ "$missing" == "0" ]] && { touch "$STATE_DIR/$cat.installed"; echo -e "${GRN}Done.${RST} '$name' tools are ready to use."; } || return 1
        return 0
    fi

    echo -e "${BOLD}Installing mission pack:${RST} $name"
    [[ "$type" == "fetch" || "$type" == "mixed" ]] && echo -e "${CYAN}Some tools may be downloaded from upstream releases...${RST}"
    [[ "$type" == "apt" || "$type" == "mixed" ]] && ensure_apt_lists
    local fail=0
    for p in $pkgs; do
        install_token "$p" "$type" || fail=1
    done
    if [[ "$fail" == "0" ]]; then
        touch "$STATE_DIR/$cat.installed"
        if [[ "$cat" == "xfce" ]]; then
            # xfce/lightdm pull in systemd-sysv as a dependency, which
            # silently overwrites /sbin/init with a symlink to systemd.
            # SageOS boots via OpenRC — restore the correct init target.
            ln -sf openrc-init /sbin/init
            # Ensure the sage user actually owns their own home directory.
            # If it's root-owned (can happen from some rootfs build paths),
            # sage can't write .Xauthority/.ICEauthority/.cache/.config,
            # causing the XFCE session to die instantly right after login
            # with no obvious error (xfce4-session/dbus fail silently).
            chown -R sage:sage /home/sage 2>/dev/null || true
            # Make xfce4-terminal (VTE-based, proper truecolor + Unicode
            # block glyph rendering) the default TerminalEmulator instead
            # of falling back to plain xterm, whose default core bitmap
            # font renders the dense 24-bit-truecolor block-art SageOS
            # logo (in fastfetch) as a scrambled/glitchy mess.
            mkdir -p /etc/xdg/xfce4
            if [[ -f /etc/xdg/xfce4/helpers.rc ]]; then
                sed -i 's/^TerminalEmulator=.*/TerminalEmulator=xfce4-terminal/' /etc/xdg/xfce4/helpers.rc
            else
                cat > /etc/xdg/xfce4/helpers.rc << 'HELPEOF'
WebBrowser=debian-sensible-browser
MailReader=thunderbird
TerminalEmulator=xfce4-terminal
FileManager=thunar
HELPEOF
            fi
            # Debian's udev LSB init.d script doesn't reliably start under
            # OpenRC (silently stays "stopped"), leaving new input devices
            # untagged (no ID_INPUT_KEYBOARD) so libinput/X never see the
            # keyboard/mouse. Install a dedicated OpenRC service that starts
            # udevd directly and triggers+settles device tagging before X.
            if [[ ! -f /etc/init.d/sage-udev-fix ]]; then
                cat > /etc/init.d/sage-udev-fix << 'UDEVEOF'
#!/sbin/openrc-run
description="Ensure systemd-udevd is running and input devices are tagged before X starts (works around the Debian udev LSB init.d script not reliably starting under OpenRC)"

depend() {
	before x11-common
	before sage-gpu-modules
}

start() {
	ebegin "Ensuring udev daemon is running and devices are tagged"
	if ! pgrep -x systemd-udevd >/dev/null 2>&1; then
		/lib/systemd/systemd-udevd --daemon
		sleep 1
	fi
	udevadm trigger --action=add >/dev/null 2>&1
	udevadm settle --timeout=10 >/dev/null 2>&1
	eend 0
}
UDEVEOF
                chmod 755 /etc/init.d/sage-udev-fix
            fi
            rc-update add sage-udev-fix default >/dev/null 2>&1
            rc-update add sage-gpu-modules default >/dev/null 2>&1
            rc-update add lightdm default >/dev/null 2>&1
            # Best-effort for the CURRENT live session too (in case the
            # user tries the graphical login without rebooting first).
            modprobe evdev 2>/dev/null; modprobe psmouse 2>/dev/null; modprobe serio_raw 2>/dev/null
            echo -e "${GRN}Done.${RST} '$name' installed. ${CYAN}Reboot to reach the graphical login screen.${RST}"
        else
            echo -e "${GRN}Done.${RST} '$name' tools are ready to use."
        fi
    else
        echo -e "${YEL}Some tools failed to install — check your network/output above and try again.${RST}"
        return 1
    fi
}

cmd_remove_one() {
    local cat="$1"
    local row; row=$(find_category "$cat")
    [[ -z "$row" ]] && { echo "Unknown category: $cat"; return 1; }
    local name pkgs type; name=$(get_field "$row" 2); pkgs=$(get_field "$row" 4); type=$(get_field "$row" 5)
    if [[ "$type" == "builtin" ]]; then
        echo "'$cat' is a builtin pack baked into the base ISO and can't be removed at runtime."
        return 1
    fi
    echo -e "${BOLD}Removing mission pack:${RST} $name"
    for p in $pkgs; do remove_token "$p" "$type"; done
    rm -f "$STATE_DIR/$cat.installed"
    if [[ "$cat" == "xfce" ]]; then
        rc-update del lightdm default >/dev/null 2>&1
        rc-update del sage-gpu-modules default >/dev/null 2>&1
        rc-update del sage-udev-fix default >/dev/null 2>&1
    fi
    echo -e "${GRN}Done.${RST}"
}

cmd_install() {
    if [[ "$1" == "all" ]]; then
        local fail=0
        for cat in $(all_categories); do
            echo -e "${BOLD}${CYAN}=== $cat ===${RST}"
            cmd_install_one "$cat" || fail=1
            echo ""
        done
        [[ "$fail" == "0" ]] && echo -e "${GRN}All mission packs installed.${RST}" || echo -e "${YEL}Finished — some packs had issues, see above.${RST}"
        return
    fi
    cmd_install_one "$1"
}

cmd_remove() {
    if [[ "$1" == "all" ]]; then
        for cat in $(all_categories); do
            [[ -f "$STATE_DIR/$cat.installed" ]] || continue
            local row type; row=$(find_category "$cat"); type=$(get_field "$row" 5)
            [[ "$type" == "builtin" ]] && continue
            echo -e "${BOLD}${CYAN}=== $cat ===${RST}"
            cmd_remove_one "$cat"
            echo ""
        done
        echo -e "${GRN}All removable mission packs removed.${RST}"
        return
    fi
    cmd_remove_one "$1"
}

cmd_status() {
    echo -e "${BOLD}Installed mission packs:${RST}"
    local any=0
    while IFS='|' read -r cat name desc pkgs type; do
        [[ "$cat" =~ ^#.*$ || -z "$cat" ]] && continue
        if [[ -f "$STATE_DIR/$cat.installed" ]]; then
            echo -e "  ${GRN}yes${RST} $cat — $name"
            any=1
        fi
    done < "$CONF"
    [[ "$any" == "0" ]] && echo "  (none yet — run 'sage-pkg list' to see options)"
}

cmd_check() {
    local target="$1"
    while IFS='|' read -r cat name desc pkgs type; do
        [[ "$cat" =~ ^#.*$ || -z "$cat" ]] && continue
        [[ -n "$target" && "$cat" != "$target" ]] && continue
        local total=0 present=0
        for p in $pkgs; do
            total=$((total+1))
            local n; n=$(pkg_name "$p")
            local t; t=$(pkg_type "$p" "$type")
            local eb; eb=$(effective_bin "$p" "$type")
            if [[ "$t" == "apt" ]]; then
                dpkg -s "$n" >/dev/null 2>&1 && present=$((present+1))
            else
                command -v "$eb" >/dev/null 2>&1 && present=$((present+1))
            fi
        done
        local verdict="${RED}not installed${RST}"
        [[ "$present" -eq "$total" ]] && verdict="${GRN}fully installed ($present/$total)${RST}"
        [[ "$present" -gt 0 && "$present" -lt "$total" ]] && verdict="${YEL}partially installed ($present/$total)${RST}"
        echo -e "  ${MAG}$cat${RST} — $name: $verdict"
        if [[ "$present" -eq "$total" ]]; then touch "$STATE_DIR/$cat.installed"; else rm -f "$STATE_DIR/$cat.installed"; fi
    done < "$CONF"
}

cmd_search() {
    local term="$1"
    while IFS='|' read -r cat name desc pkgs type; do
        [[ "$cat" =~ ^#.*$ || -z "$cat" ]] && continue
        for p in $pkgs; do
            local n; n=$(pkg_name "$p")
            if [[ "$n" == *"$term"* ]]; then
                echo -e "  ${MAG}$n${RST} — found in category '${cat}' ($name)"
            fi
        done
    done < "$CONF"
}

cmd_update() {
    local target="${1:-all}"

    echo -e "${BOLD}${CYAN}Step 1/2: refreshing catalog...${RST}"
    cmd_update_catalog || echo -e "${YEL}(catalog refresh failed — continuing with upgrade using the existing local catalog)${RST}"
    echo ""
    echo -e "${BOLD}${CYAN}Step 2/2: upgrading installed tools...${RST}"

    local cats_to_update=()
    if [[ "$target" == "all" ]]; then
        for c in $(all_categories); do
            [[ -f "$STATE_DIR/$c.installed" ]] && cats_to_update+=("$c")
        done
    else
        if [[ -f "$STATE_DIR/$target.installed" ]]; then
            cats_to_update+=("$target")
        else
            echo -e "${RED}'$target' is not installed${RST} — nothing to update. Run 'sage-pkg install $target' first."
            return 1
        fi
    fi

    if [[ ${#cats_to_update[@]} -eq 0 ]]; then
        echo "No mission packs are installed yet — nothing to update."
        return 0
    fi

    # Bucket every tool across the installed categories in scope by its
    # effective install method, so apt tools get upgraded in ONE batched
    # apt-get call (fast, resolves deps together) instead of one at a time.
    local apt_pkgs=() fetch_pkgs=() pip_pkgs=() skip_builtin=()
    for cat in "${cats_to_update[@]}"; do
        local row; row=$(find_category "$cat")
        [[ -z "$row" ]] && continue
        local pkgs type; pkgs=$(get_field "$row" 4); type=$(get_field "$row" 5)
        if [[ "$type" == "builtin" ]]; then
            skip_builtin+=("$cat")
            continue
        fi
        for p in $pkgs; do
            local n; n=$(pkg_name "$p")
            local t; t=$(pkg_type "$p" "$type")
            case "$t" in
                apt) apt_pkgs+=("$n") ;;
                fetch) fetch_pkgs+=("$n") ;;
                pip) pip_pkgs+=("$n") ;;
            esac
        done
    done

    # de-dup (a tool can appear in more than one category). Plain command
    # substitution (not process substitution) — doesn't depend on /dev/fd,
    # which may not exist if /proc isn't mounted in some environments.
    [[ ${#apt_pkgs[@]} -gt 0 ]] && apt_pkgs=($(printf "%s\n" "${apt_pkgs[@]}" | sort -u))
    [[ ${#fetch_pkgs[@]} -gt 0 ]] && fetch_pkgs=($(printf "%s\n" "${fetch_pkgs[@]}" | sort -u))
    [[ ${#pip_pkgs[@]} -gt 0 ]] && pip_pkgs=($(printf "%s\n" "${pip_pkgs[@]}" | sort -u))

    local any_upgraded=0

    if [[ ${#apt_pkgs[@]} -gt 0 ]]; then
        echo -e "${CYAN}Refreshing apt package lists...${RST}"
        DEBIAN_FRONTEND=noninteractive apt-get update -qq
        echo -e "${CYAN}Upgrading ${#apt_pkgs[@]} apt-based tool(s): ${apt_pkgs[*]}${RST}"
        if DEBIAN_FRONTEND=noninteractive apt-get install --only-upgrade -y "${apt_pkgs[@]}"; then
            any_upgraded=1
        else
            echo -e "${YEL}Some apt tools failed to upgrade — see output above.${RST}"
        fi
    fi

    if [[ ${#fetch_pkgs[@]} -gt 0 ]]; then
        echo -e "${CYAN}Re-fetching ${#fetch_pkgs[@]} GitHub-release tool(s) to their latest release...${RST}"
        for n in "${fetch_pkgs[@]}"; do
            fetch_one "$n" && any_upgraded=1
        done
    fi

    if [[ ${#pip_pkgs[@]} -gt 0 ]]; then
        echo -e "${CYAN}Upgrading ${#pip_pkgs[@]} pip-based tool(s): ${pip_pkgs[*]}${RST}"
        for n in "${pip_pkgs[@]}"; do
            local row pip_pkg; row=$(grep -v "^#" "$PIP_CONF" | awk -F'|' -v tt="$n" '$1==tt')
            pip_pkg=$(echo "$row" | cut -d'|' -f2)
            if [[ -n "$pip_pkg" ]] && pip3 install --break-system-packages --quiet --upgrade "$pip_pkg" >/tmp/sage-pkg-pip.log 2>&1; then
                echo -e "  ${GRN}upgraded${RST} $n"
                any_upgraded=1
            else
                echo -e "  ${YEL}skipped/failed${RST} $n — see /tmp/sage-pkg-pip.log"
            fi
        done
    fi

    [[ ${#skip_builtin[@]} -gt 0 ]] && echo -e "${YEL}Skipped builtin pack(s): ${skip_builtin[*]}${RST} — pre-baked into the ISO, nothing to fetch at runtime."

    if [[ ${#apt_pkgs[@]} -eq 0 && ${#fetch_pkgs[@]} -eq 0 && ${#pip_pkgs[@]} -eq 0 ]]; then
        echo "Nothing to upgrade in scope (only builtin tools installed, or category has no external packages)."
    else
        echo -e "${GRN}Update complete.${RST} Run 'sage-pkg check' to verify everything's still in order."
    fi
}

self_update_check() {
    local self_path; self_path=$(command -v sage-pkg 2>/dev/null || echo "/usr/local/bin/sage-pkg")
    local self_dir; self_dir=$(dirname "$self_path")
    # Download into a temp file in the SAME directory as the destination (same
    # filesystem — required for the rename below to be atomic).
    local tmp; tmp=$(mktemp "$self_dir/.sage-pkg.XXXXXX" 2>/dev/null) || tmp=$(mktemp)
    if ! curl -sfL "$SAGE_PKG_SELF_URL" -o "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    if [[ ! -s "$tmp" ]] || ! bash -n "$tmp" 2>/dev/null; then
        echo -e "  ${YEL}downloaded sage-pkg failed a sanity check — skipping self-update this run${RST}"
        rm -f "$tmp"
        return 1
    fi
    if ! cmp -s "$tmp" "$self_path" 2>/dev/null; then
        chmod 755 "$tmp"
        # IMPORTANT: rename (mv), never cp/overwrite-in-place, here. This
        # script is CURRENTLY RUNNING from $self_path — bash reads a script
        # file incrementally from disk as it executes, not all at once into
        # memory. Overwriting $self_path's bytes in place (cp) can corrupt
        # THIS process's own execution mid-run (observed once: garbled
        # "line N: c: command not found" errors right after the in-place
        # overwrite). A same-filesystem rename swaps the directory entry to
        # a new inode instead — this process keeps its already-open file
        # descriptor pointing at the untouched OLD inode and finishes
        # executing its original bytes safely; only the NEXT invocation of
        # sage-pkg opens the new file.
        mv -f "$tmp" "$self_path"
        echo -e "  ${GRN}sage-pkg itself was updated${RST} to the latest version from GitHub."
    else
        rm -f "$tmp"
    fi
    return 0
}

cmd_update_catalog() {
    echo -e "${BOLD}${CYAN}Updating sage-pkg catalog from GitHub...${RST}"
    echo "  checking for a newer sage-pkg itself..."
    self_update_check
    local tmp; tmp=$(mktemp -d)
    local files="categories.conf fetch-tools.conf pip-tools.conf tool-descriptions.conf"
    local ok=1
    for f in $files; do
        echo -n "  fetching $f... "
        if curl -sfL "$CATALOG_BASE/$f" -o "$tmp/$f" && [[ -s "$tmp/$f" ]]; then
            echo -e "${GRN}ok${RST}"
        else
            echo -e "${RED}failed${RST}"
            ok=0
        fi
    done
    if [[ "$ok" != "1" ]]; then
        echo -e "${RED}Catalog update aborted — network issue or files missing upstream. Nothing was changed.${RST}"
        find "$tmp" -delete
        return 1
    fi

    # Version + changelog (best-effort — older sage-pkg installs upgrading for
    # the first time won't have a local VERSION file yet, that's fine).
    local old_version=""; [[ -f "$CATALOG_VERSION_FILE" ]] && old_version=$(cat "$CATALOG_VERSION_FILE")
    local new_version=""
    curl -sfL "$CATALOG_BASE/VERSION" -o "$tmp/VERSION" 2>/dev/null
    [[ -s "$tmp/VERSION" ]] && new_version=$(cat "$tmp/VERSION")

    # backup then swap in atomically
    local backup="/usr/local/share/sage-pkg/.backup-$(date +%s)"
    mkdir -p "$backup"
    for f in $files; do
        [[ -f "/usr/local/share/sage-pkg/$f" ]] && cp "/usr/local/share/sage-pkg/$f" "$backup/$f"
        cp "$tmp/$f" "/usr/local/share/sage-pkg/$f"
    done
    find "$tmp" -delete
    local new_cats; new_cats=$(all_categories | wc -l)

    if [[ -n "$new_version" ]]; then
        echo "$new_version" > "$CATALOG_VERSION_FILE"
        if [[ -z "$old_version" ]]; then
            echo -e "${GRN}Catalog updated${RST} to ${BOLD}v$new_version${RST} — $new_cats categories (previous copy backed up to $backup)."
        elif [[ "$old_version" != "$new_version" ]]; then
            echo -e "${GRN}Catalog updated${RST} from v$old_version to ${BOLD}v$new_version${RST} — $new_cats categories (previous copy backed up to $backup)."
            echo -e "${CYAN}What changed:${RST}"
            local changelog_tmp; changelog_tmp=$(mktemp)
            if curl -sfL "https://raw.githubusercontent.com/zackmsa777-a11y/sageos/main/docs/changelog.json" -o "$changelog_tmp" 2>/dev/null && [[ -s "$changelog_tmp" ]] && command -v python3 &>/dev/null; then
                python3 -c "
import json
try:
    log = json.load(open('$changelog_tmp'))
    for entry in log:
        if entry.get('version') == '$new_version':
            for c in entry.get('changes', []):
                print('  - ' + c)
except Exception:
    pass
"
            fi
            find "$changelog_tmp" -delete 2>/dev/null
        else
            echo -e "${GRN}Catalog refreshed${RST} — still on v$new_version, $new_cats categories (previous copy backed up to $backup)."
        fi
    else
        echo -e "${GRN}Catalog updated.${RST} $new_cats categories now available (previous copy backed up to $backup)."
    fi
    echo "Run 'sage-pkg list' to see what's new. Full history: https://zackmsa777-a11y.github.io/sageos/changelog.html"
}

case "$1" in
    list) cmd_list ;;
    show) cmd_show "$2" ;;
    tools) cmd_tools "$2" ;;
    install) [[ -z "$2" ]] && usage; cmd_install "$2" ;;
    remove) [[ -z "$2" ]] && usage; cmd_remove "$2" ;;
    status) cmd_status ;;
    check) cmd_check "$2" ;;
    search) cmd_search "$2" ;;
    update) cmd_update "$2" ;;
    update-catalog) cmd_update_catalog ;;
    *) usage ;;
esac

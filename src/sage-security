#!/bin/bash
# sage-security — friendly whiptail menu for browsing/installing/launching
# SageOS cybersecurity mission packs, built on top of sage-pkg.

CONF="/usr/local/share/sage-pkg/categories.conf"
STATE_DIR="/var/lib/sage-pkg"
BACKTITLE="SageOS — Cybersecurity Mission Control"

need_root() {
    if [[ $EUID -ne 0 ]]; then
        whiptail --backtitle "$BACKTITLE" --msgbox "Run this as root (or with sudo) to install/remove tools." 8 60
        return 1
    fi
    return 0
}

main_menu() {
    while true; do
        local items=()
        while IFS='|' read -r cat name desc pkgs type; do
            [[ "$cat" =~ ^#.*$ || -z "$cat" ]] && continue
            local tag="$name"
            [[ -f "$STATE_DIR/$cat.installed" ]] && tag="$name [installed]"
            items+=("$cat" "$tag")
        done < "$CONF"

        CHOICE=$(whiptail --backtitle "$BACKTITLE" --title "Mission Packs" \
            --menu "Choose a category, or use an action below:" 22 74 10 \
            "${items[@]}" \
            "STATUS_CHECK" "Check what's installed" \
            "BROWSE_TOOLS"  "Browse all tools & what they do" \
            "REMOVE_ALL" "Remove ALL installed packs" \
            3>&1 1>&2 2>&3)
        [[ $? -ne 0 ]] && break

        case "$CHOICE" in
            STATUS_CHECK)    status_screen ;;
            BROWSE_TOOLS)     tools_browser ;;
            REMOVE_ALL) remove_all_flow ;;
            *)             category_menu "$CHOICE" ;;
        esac
    done
    clear
}

status_screen() {
    local out
    out=$(sage-pkg check 2>&1 | sed -E 's/\x1b\[[0-9;]*m//g')
    whiptail --backtitle "$BACKTITLE" --title "Mission Pack Status" \
        --scrolltext --msgbox "$out" 24 76
}

tools_browser() {
    local items=()
    while IFS='|' read -r cat name desc pkgs type; do
        [[ "$cat" =~ ^#.*$ || -z "$cat" ]] && continue
        items+=("$cat" "$name")
    done < "$CONF"
    items+=("all" "Every tool in every pack")

    CAT=$(whiptail --backtitle "$BACKTITLE" --title "Browse Tools" \
        --menu "Pick a pack to see its tools and what they do:" 20 74 8 \
        "${items[@]}" 3>&1 1>&2 2>&3)
    [[ $? -ne 0 ]] && return

    local out
    if [[ "$CAT" == "all" ]]; then
        out=$(sage-pkg tools 2>&1 | sed -E 's/\x1b\[[0-9;]*m//g')
    else
        out=$(sage-pkg tools "$CAT" 2>&1 | sed -E 's/\x1b\[[0-9;]*m//g')
    fi
    whiptail --backtitle "$BACKTITLE" --title "Tools" \
        --scrolltext --msgbox "$out" 26 78
}

remove_all_flow() {
    need_root || return
    whiptail --backtitle "$BACKTITLE" --title "Remove ALL Mission Packs" \
        --yesno "This will remove every installed mission pack (networking, web, password, wireless, sniffing, forensics, etc). Builtin tools baked into the base ISO are never removed.\n\nContinue?" 12 70
    [[ $? -ne 0 ]] && return
    whiptail --backtitle "$BACKTITLE" --infobox "Removing all installed mission packs..." 8 60
    sage-pkg remove all > /tmp/sage-remove-all.log 2>&1
    whiptail --backtitle "$BACKTITLE" --title "Done" --scrolltext --msgbox "$(sed -E 's/\x1b\[[0-9;]*m//g' /tmp/sage-remove-all.log)" 22 76
}

category_menu() {
    local cat="$1"
    local row name desc pkgs type
    row=$(grep -v "^#" "$CONF" | awk -F'|' -v c="$cat" '$1==c')
    name=$(echo "$row" | cut -d'|' -f2)
    desc=$(echo "$row" | cut -d'|' -f3)
    pkgs=$(echo "$row" | cut -d'|' -f4)
    type=$(echo "$row" | cut -d'|' -f5)
    local installed="not installed"
    [[ -f "$STATE_DIR/$cat.installed" ]] && installed="installed"

    local tool_list=""
    for p in $pkgs; do tool_list+="  - $p\n"; done

    local action_opts=("install" "Install all tools in this pack")
    if [[ "$type" == "builtin" ]]; then
        action_opts=("check" "Verify tools are present")
    else
        action_opts+=("remove"  "Remove all tools in this pack")
    fi
    action_opts+=("tools" "See what each tool does")
    action_opts+=("back"    "Return to category list")

    ACTION=$(whiptail --backtitle "$BACKTITLE" --title "$name ($installed)" \
        --menu "$desc\n\nTools:\n$tool_list" 24 72 5 \
        "${action_opts[@]}" \
        3>&1 1>&2 2>&3)
    [[ $? -ne 0 ]] && return

    case "$ACTION" in
        install)
            need_root || return
            whiptail --backtitle "$BACKTITLE" --infobox "Installing '$name'...\nThis may take a minute." 8 60
            sage-pkg install "$cat" > /tmp/sage-install.log 2>&1
            whiptail --backtitle "$BACKTITLE" --title "Result" --scrolltext --msgbox "$(sed -E 's/\x1b\[[0-9;]*m//g' /tmp/sage-install.log)" 20 74
            ;;
        remove)
            need_root || return
            whiptail --backtitle "$BACKTITLE" --infobox "Removing '$name'..." 8 60
            sage-pkg remove "$cat" > /tmp/sage-remove.log 2>&1
            whiptail --backtitle "$BACKTITLE" --title "Result" --scrolltext --msgbox "$(sed -E 's/\x1b\[[0-9;]*m//g' /tmp/sage-remove.log)" 20 74
            ;;
        check)
            local out; out=$(sage-pkg check "$cat" 2>&1 | sed -E 's/\x1b\[[0-9;]*m//g')
            whiptail --backtitle "$BACKTITLE" --title "Check" --msgbox "$out" 12 74
            ;;
        tools)
            local out; out=$(sage-pkg tools "$cat" 2>&1 | sed -E 's/\x1b\[[0-9;]*m//g')
            whiptail --backtitle "$BACKTITLE" --title "$name — Tools" --scrolltext --msgbox "$out" 24 76
            ;;
        back) return ;;
    esac
}

main_menu

#!/bin/busybox sh
# SageOS v5.1 — Live boot init

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# Safety net: PID 1 must NEVER actually exit or the kernel panics with
# "Attempted to kill init!". If anything in this script below causes the
# interpreter itself to terminate unexpectedly (a crash, an unhandled
# signal, a stray exit, hardware-specific busybox misbehavior, etc.),
# fall back to an interactive shell instead of taking the whole machine
# down. This does NOT protect against a crash of the real init *after*
# switch_root (that process fully replaces us), but it covers every
# failure mode while we are still in the initramfs stage.
trap 'echo "[live] init exited unexpectedly (code $?) - respawning emergency shell"; exec /bin/busybox sh' EXIT

# Mount essential filesystems (mountpoint dirs must exist first —
# the initramfs cpio image doesn't ship them, unlike a real rootfs)
/bin/busybox mkdir -p /proc /sys /dev /mnt /tmp /run
/bin/busybox mount -t proc none /proc
/bin/busybox mount -t sysfs none /sys
/bin/busybox mount -t devtmpfs none /dev 2>/dev/null || /bin/busybox mdev -s

echo "[live] SageOS v5.1 live-boot starting..."

# Load kernel modules (in dependency order)
MODDIR="/lib/modules/$(ls /lib/modules)"
echo "[live] Loading kernel modules..."

load_mod() {
  if [ -f "$MODDIR/$1" ]; then
    /bin/busybox insmod "$MODDIR/$1" 2>/dev/null && echo "[live]   loaded: $1" || true
  fi
}

# CRC deps (needed by t10-pi)
load_mod crct10dif_common.ko
load_mod crc-t10dif.ko
load_mod crc64.ko
load_mod crc64-rocksoft.ko

# Core SCSI
load_mod scsi_common.ko
load_mod scsi_mod.ko
load_mod t10-pi.ko

# ATA/SATA
load_mod libata.ko
load_mod libahci.ko
load_mod ata_piix.ko
load_mod ahci.ko

# CD-ROM
load_mod cdrom.ko
load_mod sr_mod.ko

# Disk
load_mod sd_mod.ko

# Loop device (for mounting squashfs from CD)
load_mod loop.ko

# Virtio core
load_mod virtio.ko
load_mod virtio_ring.ko
load_mod virtio_pci_legacy_dev.ko
load_mod virtio_pci_modern_dev.ko
load_mod virtio_pci.ko
load_mod virtio_blk.ko
load_mod virtio_scsi.ko

# Virtio net (needs failover deps first)
load_mod failover.ko
load_mod net_failover.ko
load_mod virtio_net.ko

# Other common emulated NICs (VirtualBox default = e1000/PCnet)
load_mod mii.ko
load_mod e1000.ko
load_mod e1000e.ko
load_mod pcnet32.ko

load_mod virtio_console.ko
load_mod virtio_balloon.ko
load_mod virtio_input.ko
load_mod virtio-rng.ko

# PS/2 keyboard/mouse core + generic event interface. Without evdev.ko,
# NO input device (PS/2, virtio-input, or USB) can expose a /dev/input/eventX
# node, which breaks all keyboard/mouse input under X11/libinput on every
# hypervisor (QEMU, VirtualBox) and real hardware alike. serio_raw/psmouse
# add PS/2 mouse support (atkbd/i8042 for keyboard are kernel built-ins).
load_mod serio_raw.ko
load_mod psmouse.ko
load_mod evdev.ko

# Virtio GPU DRM stack — cec.ko and virtio-gpu.ko still fail with
# unresolved symbols on this kernel build (missing rc-core / virtio_dma_buf
# helpers we don't ship) and only waste boot time under slow/unaccelerated
# emulation, so we skip loading them. Standard VGA/framebuffer display
# still works; only 3D/DRM accel is unavailable.
load_mod drm.ko
load_mod drm_shmem_helper.ko
load_mod drm_kms_helper.ko
load_mod ttm.ko
load_mod drm_ttm_helper.ko

# Filesystems (ext4 needed to read a persistence volume, if present)
load_mod isofs.ko
load_mod squashfs.ko
load_mod overlay.ko
load_mod crc16.ko
load_mod crc32c_generic.ko
load_mod mbcache.ko
load_mod jbd2.ko
load_mod ext4.ko

# Give devices time to settle
sleep 2
/bin/busybox mdev -s 2>/dev/null
/bin/busybox chmod 666 /dev/null /dev/zero /dev/full /dev/random /dev/urandom /dev/tty 2>/dev/null
/bin/busybox chmod 620 /dev/console 2>/dev/null

echo "[live] Block devices: $(ls /dev/sr* /dev/sd* /dev/vd* /dev/loop* 2>/dev/null)"

# Find the boot media
SQUASHFS=""
LIVE_DEV=""
MOUNT_POINT="/mnt/media"
mkdir -p "$MOUNT_POINT"

for dev in $(ls /dev/sr* /dev/sd* /dev/vd* 2>/dev/null); do
  [ -b "$dev" ] || continue
  echo "[live] Probing $dev (max 5s each)..."
  /bin/busybox timeout 5 /bin/busybox mount -t iso9660 -o ro "$dev" "$MOUNT_POINT" 2>/dev/null || \
  /bin/busybox timeout 5 /bin/busybox mount -t vfat -o ro "$dev" "$MOUNT_POINT" 2>/dev/null || \
  /bin/busybox timeout 5 /bin/busybox mount -t ext4 -o ro "$dev" "$MOUNT_POINT" 2>/dev/null
  echo "[live] Done probing $dev"

  if [ -f "$MOUNT_POINT/live/rootfs.squashfs" ]; then
    SQUASHFS="$MOUNT_POINT/live/rootfs.squashfs"
    LIVE_DEV="$dev"
    echo "[live] Found rootfs.squashfs on $dev"
    break
  else
    /bin/busybox umount "$MOUNT_POINT" 2>/dev/null
  fi
done

if [ -z "$SQUASHFS" ]; then
  echo "[live] ERROR: Could not find rootfs.squashfs!"
  exec /bin/busybox sh
fi

# Copy squashfs into RAM before mounting.
# Reading a compressed squashfs live off a virtual optical drive works,
# but on VirtualBox's ATAPI/IDE CD-ROM emulation every random-access read
# for decompression is slow (unlike QEMU virtio or real hardware), so the
# *entire session* (not just boot) drags. Copying once into tmpfs turns
# every read after this point into a RAM read, at the cost of one linear
# copy up front (much faster than the repeated slow reads it replaces).
SQUASHFS_SIZE=$(/bin/busybox stat -c %s "$SQUASHFS" 2>/dev/null || echo 0)
SQUASHFS_KB=$((SQUASHFS_SIZE / 1024))
MEMTOTAL_KB=$(/bin/busybox awk '/MemTotal/{print $2}' /proc/meminfo 2>/dev/null || echo 0)
# Only copy to RAM if we have at least 2x the squashfs size free (squashfs + headroom for the running OS)
# NOTE: stay in KB throughout — busybox ash arithmetic overflows 32-bit signed
# range if we convert to bytes on a system with >2GB RAM (2GB in bytes alone
# exceeds INT32_MAX), which silently breaks the comparison.
if [ "$SQUASHFS_KB" -gt 0 ] && [ "$MEMTOTAL_KB" -gt $((SQUASHFS_KB * 2)) ]; then
  echo "[live] Copying squashfs to RAM ($((SQUASHFS_KB / 1024))MB, this can take a bit on slow virtual CD-ROMs)..."
  mkdir -p /mnt/ramsquash
  /bin/busybox mount -t tmpfs -o size=$((SQUASHFS_KB / 1024 + 32))m none /mnt/ramsquash
  if /bin/busybox cp "$SQUASHFS" /mnt/ramsquash/rootfs.squashfs; then
    echo "[live] Copy to RAM complete"
    SQUASHFS="/mnt/ramsquash/rootfs.squashfs"
  else
    echo "[live] RAM copy failed, falling back to direct read from media"
    /bin/busybox umount /mnt/ramsquash 2>/dev/null
  fi
else
  echo "[live] Not enough RAM headroom to copy squashfs, reading directly from media (will be slower on VirtualBox)"
fi

# Set up loop device for the squashfs file
LOOPDEV=$(/bin/busybox losetup -f 2>/dev/null)
if [ -n "$LOOPDEV" ]; then
  /bin/busybox losetup -r "$LOOPDEV" "$SQUASHFS" 2>/dev/null
  echo "[live] Loop device: $LOOPDEV -> $SQUASHFS"
else
  echo "[live] No loop device available, trying direct mount..."
  LOOPDEV="$SQUASHFS"
fi

# Mount the squashfs
echo "[live] Mounting squashfs rootfs..."
mkdir -p /mnt/ro
if ! /bin/busybox mount -t squashfs -o ro "$LOOPDEV" /mnt/ro; then
  echo "[live] ERROR: squashfs mount failed! Trying direct mount..."
  if ! /bin/busybox mount -t squashfs -o ro "$SQUASHFS" /mnt/ro; then
    echo "[live] FATAL: Cannot mount squashfs rootfs!"
    exec /bin/busybox sh
  fi
fi
echo "[live] Mounted squashfs rootfs"

# --- Persistence detection ---
# Look for a separate ext4 volume (a second disk/partition, not the
# device we booted from) carrying a marker file. Created by running
# `sage-persistence-setup` from inside an already-booted SageOS session.
# If found, real writes (installed packs, home dir, config changes) land
# there and survive reboot. If not found, we fall back to tmpfs like
# before (works during the session, wiped on reboot).
PERSIST_DEV=""
mkdir -p /mnt/persist
echo "[live] Scanning for persistence volume (max 5s per device)..."
for dev in $(ls /dev/sd* /dev/vd* /dev/nvme*n*p* 2>/dev/null); do
  [ -b "$dev" ] || continue
  [ "$dev" = "$LIVE_DEV" ] && continue
  echo "[live] Checking $dev for persistence marker..."
  if /bin/busybox timeout 5 /bin/busybox mount -t ext4 -o rw "$dev" /mnt/persist 2>/dev/null; then
    if [ -f /mnt/persist/.sageos-persistence ]; then
      PERSIST_DEV="$dev"
      echo "[live] Persistence volume found: $dev"
      break
    fi
    /bin/busybox umount /mnt/persist 2>/dev/null
  fi
done

mkdir -p /mnt/rw
if [ -n "$PERSIST_DEV" ]; then
  mkdir -p /mnt/persist/upper /mnt/persist/work
  UPPERDIR=/mnt/persist/upper
  WORKDIR=/mnt/persist/work
  echo "[live] Persistence ENABLED (writes will survive reboot: $PERSIST_DEV)"
else
  /bin/busybox mount -t tmpfs none /mnt/rw
  mkdir -p /mnt/rw/upper /mnt/rw/work
  UPPERDIR=/mnt/rw/upper
  WORKDIR=/mnt/rw/work
  echo "[live] No persistence volume — using tmpfs (writes lost on reboot)"
fi

# Set up overlayfs
mkdir -p /mnt/overlay
if /bin/busybox mount -t overlay overlay \
  -o "lowerdir=/mnt/ro,upperdir=$UPPERDIR,workdir=$WORKDIR" \
  /mnt/overlay; then
  echo "[live] Overlay filesystem ready"
else
  echo "[live] Overlay failed, using squashfs directly..."
  /bin/busybox mount --move /mnt/ro /mnt/overlay 2>/dev/null || {
    ln -sf /mnt/ro /mnt/overlay
  }
fi

# Verify init exists. Prefer /sbin/init (the real distro init, e.g. OpenRC)
# over /init (a legacy custom bootstrap script), falling back to /init only
# if no /sbin/init is present.
if [ -f /mnt/overlay/sbin/init ]; then
  echo "[live] Using /sbin/init (real init system)"
  INIT_TARGET="/sbin/init"
elif [ -f /mnt/overlay/init ]; then
  echo "[live] /sbin/init not found, falling back to /init"
  INIT_TARGET="/init"
else
  echo "[live] FATAL: No init found!"
  ls /mnt/overlay/ | head -10
  exec /bin/busybox sh
fi

# Move kernel filesystems into new root
mkdir -p /mnt/overlay/proc /mnt/overlay/sys /mnt/overlay/dev /mnt/overlay/run
/bin/busybox mount --move /proc /mnt/overlay/proc
/bin/busybox mount --move /sys /mnt/overlay/sys
/bin/busybox mount --move /dev /mnt/overlay/dev

echo "[live] Switching to real root ($INIT_TARGET)..."

# Switch root and exec the real init
exec /bin/busybox switch_root /mnt/overlay "$INIT_TARGET"
